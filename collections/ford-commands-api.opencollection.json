        },
        {
          "info": {
            "name": "Check lock command status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mps.ford.com/api/fordconnect/vehicles/v1/:vehicleId/lock/:commandId",
